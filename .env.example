# ==============================================================================
# CareBridge AI - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME="CareBridge AI"
# APP_SECRET_KEY or JWT_SECRET (must be >= 32 characters in production)
APP_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
LOG_LEVEL=info

# Server Configuration
HOST=0.0.0.0
PORT=8080

# Database Configuration
# Local SQLite default: sqlite:///./carebridge.db
# PostgreSQL / Render PostgreSQL: postgresql://user:password@host:port/dbname (or postgres://)
DATABASE_URL="sqlite:///./carebridge.db"

# Cloud Scheduler & Cron Security
# Header required for Cloud Scheduler requests: X-Scheduler-Token
CRON_API_KEY="replace-with-a-secure-cron-token"

# Email / Notification Service (SMTP)
SMTP_ENABLED=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@carebridge.ai"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="CareBridge AI Notifications <notifications@carebridge.ai>"
SMTP_TLS=true
